# App environment
APP_ENV=development
SETTLEMENT_MODE=SIMULATED

# Database
DATABASE_URL=postgres://konaet:konaet@postgres:5432/konaet_dev
REDIS_URL=redis://redis:6379

# Storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=konaet-evidence-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# API
API_PORT=8080
API_HOST=0.0.0.0
JWT_ISSUER=https://api.dev.konaet.local
JWT_SECRET=dev-secret-key-change-in-prod
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=2592000

# Blockchain
CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
BLOCKCHAIN_SIGNER_PRIVATE_KEY=replace-with-a-local-development-key

# Risk Service
RISK_SERVICE_URL=http://risk:8081

# Observability
LOG_LEVEL=debug
ENABLE_TRACES=false

# Features
PLAY_INTEGRITY_ENABLED=false
AI_ASSIST_ENABLED=false
CLEARTEXT_HTTP_ALLOWED=true

# Checkpoint & Anchor
CHECKPOINT_BATCH_SIZE=128
CHECKPOINT_BATCH_TIMEOUT_MS=10000

# Admin
ADMIN_EMAIL=admin@konaet.local
ADMIN_TEMP_PASSWORD=change-me-before-first-use
